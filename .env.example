# Copy to .env at the repo root for the Python services:
#   cp .env.example .env

OMAT_ENV=local
OMAT_LOG_LEVEL=INFO

OMAT_OPENSEARCH_URL=http://localhost:9200
OMAT_OPENSEARCH_INDEX_ALIAS=papers

OMAT_REDIS_URL=redis://localhost:6379/0
OMAT_POSTGRES_DSN=postgresql+psycopg://omat:omat@localhost:5432/omat

# Kafka/Redpanda is phase 2; set when the async profile is enabled.
OMAT_KAFKA_BROKERS=localhost:9092

# Per-paper chat. Leave the model blank until you confirm the current ID in
# Google's model list; "3.8-flash" is not a verified model name.
OMAT_GEMINI_API_KEY=
OMAT_GEMINI_MODEL=

# JSON array (pydantic-settings parses complex values as JSON).
OMAT_CORS_ORIGINS=["http://localhost:3000"]
